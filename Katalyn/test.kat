# Comments looks like this
(*  Multiline
    comments
*)

# Do not miss ;

# Variables need $ before it's name

# Real numbers
in $Pi : 4.5;
# Strings
in $salute : "Hello";

in $table : array(1,2,3,4,5);

in $token: "";
in $tokens: table;

in $arr : array(1,2,3,4);
for $arr;
    print("hola");
ok;
in $response : get_http("https://adventofcode.com/2024/leaderboard/private/view/687953.json");
print($response);